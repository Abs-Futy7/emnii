APP_NAME=ResolveOps
APP_ENV=development
DEBUG=true

DATABASE_URL=
FRONTEND_URL=http://localhost:3000

JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

CHROMA_HOST=
CHROMA_PORT=
CHROMA_SSL=false
CHROMA_PERSIST_DIR=./storage/chroma
CHROMA_COLLECTION=resolveops_document_chunks

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
RETRIEVAL_DEFAULT_TOP_K=5
RETRIEVAL_MAX_TOP_K=20

UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=25
DATASET_MAX_ROWS=250000
DATASET_SAMPLE_SIZE=5

DOCUMENT_UPLOAD_DIR=./storage/documents
MAX_DOCUMENT_UPLOAD_SIZE_MB=25
DOCUMENT_CHUNK_SIZE=1000
DOCUMENT_CHUNK_OVERLAP=150

